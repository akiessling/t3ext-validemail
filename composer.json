{
	"name": "andreaskiessling/validemail",
	"description": "Extends the TYPO3 email validation, see https://forge.typo3.org/issues/102629 and https://github.com/egulias/EmailValidator/issues/359",
	"license": [
		"GPL-2.0-or-later"
	],
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3 CMS"
	],
	"require": {
		"php": ">=8.1.0",
		"typo3/cms-core": "^12.4.0 || ^13.4.0 || ^14.0"
	},
	"require-dev": {
		"g1a/composer-test-scenarios": "^3.2"
	},
	"autoload": {
		"psr-4": {
			"AndreasKiessling\\ValidEmail\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AndreasKiessling\\ValidEmail\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"g1a/composer-test-scenarios": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true
	},
	"extra": {
		"scenarios": {
			"typo3-12": {
				"require": {
					"typo3/cms-core": "^12.4"
				},
				"require-dev": {
					"phpunit/phpunit": "^10.5",
					"typo3/testing-framework": "^8.2"
				},
				"config": {
					"platform": {
						"php": "8.2.24"
					}
				}
			},
			"typo3-13": {
				"require": {
					"typo3/cms-core": "^13.4"
				},
				"require-dev": {
					"phpunit/phpunit": "^11.2.5 || ^12.1.2",
					"typo3/testing-framework": "^9.2.0"
				},
				"config": {
					"platform": {
						"php": "8.3.23"
					}
				}
			},
            "typo3-14": {
              "require": {
                "typo3/cms-core": "^14.0"
              },
              "require-dev": {
                "phpunit/phpunit": "^12.1.2",
                "typo3/testing-framework": "^9.3.0"
              },
              "config": {
                "platform": {
                  "php": "8.3.23"
                }
              }
            }
		},
		"typo3/cms": {
			"extension-key": "validemail",
			"web-dir": ".Build/Web"
		}
	},
	"scripts": {
		"test": "phpunit -c Build/phpunit/UnitTests.xml",
		"test:detail": "phpunit -c Build/phpunit/UnitTests.xml --display-skipped --display-warnings",
		"test:testdox": "phpunit -c Build/phpunit/UnitTests.xml --testdox"
	}
}
